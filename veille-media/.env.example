# --- Base de données ---
POSTGRES_USER=veille
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=veille

# --- Sécurité (générer : python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change_me_to_a_long_random_string_of_at_least_32_chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true
TIMEZONE=Indian/Antananarivo

# --- Premier compte administrateur (créé au démarrage s'il n'existe aucun admin) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe-2026-Admin
FIRST_ADMIN_NAME=Administrateur

# --- IA ---
# gemini | openai (OpenAI ou serveur local compatible) | none
AI_PROVIDER=gemini
# Clé gratuite : https://aistudio.google.com/apikey  (ne jamais la mettre dans le frontend)
GEMINI_API_KEY=
# Vérifier le nom de modèle "Flash" courant dans Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
# Requêtes IA par minute (rester sous le quota de votre offre ; 0 = illimité)
AI_REQUESTS_PER_MINUTE=8
# Pour OpenAI / modèle local (AI_PROVIDER=openai) :
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=

# --- Collecte ---
# Identification du robot auprès des sites (mettre un contact réel de l'entreprise)
USER_AGENT=VeilleMediaBot/1.0 (veille interne; contact: communication@votre-entreprise.mg)
MAX_ARTICLES_PER_RUN=40
